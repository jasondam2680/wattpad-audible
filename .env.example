# ==============================================================================
# WATTPAD AI AUDIOBOOK - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server configuration
PORT=8000
HOST=0.0.0.0

# ------------------------------------------------------------------------------
# AI Literary Translation Service Configuration
# ------------------------------------------------------------------------------
# Provider: "openai" (default for OpenAI/OpenRouter/Local LLMs) or "mock" (for offline/testing)
TRANSLATION_PROVIDER=openai

# API Key for translation LLM provider
TRANSLATION_API_KEY=your_openai_or_openrouter_api_key_here

# Base URL for OpenAI-compatible endpoint (supports OpenAI, OpenRouter, vLLM, Ollama, DeepSeek, LiteLLM)
# Default: https://api.openai.com/v1
TRANSLATION_BASE_URL=https://api.openai.com/v1

# Target LLM Model for Literary Translation
# Recommended: gpt-4o-mini, gpt-4o, deepseek-chat, claude-3-5-sonnet-20241022
TRANSLATION_MODEL=gpt-4o-mini

# Global Translation Concurrency Limit (max parallel chapter translation calls)
GLOBAL_TRANSLATION_CONCURRENCY=2

# Concurrency for TTS Synthesis (Edge-TTS: 4, VieNeu ONNX: 1)
TTS_CONCURRENCY_EDGE=4
TTS_CONCURRENCY_VIENEU=1
