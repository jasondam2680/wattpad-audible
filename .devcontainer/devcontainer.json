{
  "name": "Wattpad AI Audiobook",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "containerEnv": {
    "VIENEU_PRECISION": "int8",
    "EDGE_TTS_CONCURRENCY": "4",
    "OMP_NUM_THREADS": "4"
  },
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y libsndfile1 ffmpeg && pip install -r backend/requirements.txt",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "Wattpad AI Audiobook Web",
      "onAutoForward": "openBrowser"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python"
      ]
    }
  }
}
